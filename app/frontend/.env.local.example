# The backend is started with --host 127.0.0.1, so nothing listens on ::1.
# Using the name "localhost" makes every request try IPv6 first and fall back,
# which measured ~2 s per call from Python and ~205 ms from curl on Windows --
# dead time on every API call and on the WebSocket. Address it literally.
# See D1 in docs/KNOWN_ISSUES.md.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://127.0.0.1:8000/api/v1
